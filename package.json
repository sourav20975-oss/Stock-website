{
  "name": "stock-knowledge-saas",
  "version": "1.0.0",
  "description": "Stock Knowledge SaaS - Indian Stock Market & IPO Research Terminal",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
